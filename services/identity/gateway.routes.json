  "internal": false,
  "routes": [
    { "method": "POST", "path": "/auth/otp/request", "auth": false },
    { "method": "POST", "path": "/auth/otp/verify", "auth": false },
    { "method": "POST", "path": "/auth/refresh", "auth": false },
    { "method": "POST", "path": "/auth/logout", "auth": true },
    { "method": "POST", "path": "/me/register", "auth": true },
