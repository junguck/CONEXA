{
  "name": "conexa",
  "version": "0.0.0",
  "private": true,
  "description": "Convexa : super-app de campus (football, rencontres, talents, services, partenariats)",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:verify": "python3 tools/verify-docs.py",
    "agents:ownership": "python3 tools/gen-agent-ownership.py",
    "tools:check-ownership": "python3 tools/check-ownership.py",
    "tools:check-migrations": "python3 tools/check-migrations.py",
    "tools:check-contracts": "python3 tools/check-contracts.py",
    "tools:check-pii": "python3 tools/check-pii-logs.py",
    "tools:check-secrets": "python3 tools/check-secrets.py",
    "test:tools": "python3 -m unittest discover -s tools/tests -v",
    "ci:guards": "pnpm tools:check-ownership && pnpm tools:check-migrations && pnpm tools:check-contracts && pnpm tools:check-pii && pnpm tools:check-secrets && pnpm test:tools",
    "verify": "pnpm docs:verify && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript-eslint": "8.72.0"
  }
}
