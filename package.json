{
  "name": "conexa",
  "version": "0.0.0",
  "private": true,
  "description": "Convexa : super-app de campus (football, rencontres, talents, services, partenariats)",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:verify": "python3 tools/verify-docs.py",
    "agents:ownership": "python3 tools/gen-agent-ownership.py",
    "db:migrate": "node tools/db-migrate.mjs",
    "seed:demo": "node tools/seed-demo.mjs",
    "test:e2e": "node tests/e2e/v1-smoke.mjs",
    "verify": "pnpm docs:verify && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "lefthook": "2.2.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript-eslint": "8.72.0"
  }
}
