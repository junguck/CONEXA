# Copier en .env pour le développement local : cp .env.example .env
# Aucune valeur réelle, aucun secret de production dans ce fichier.
# Les variables des services sont ajoutées par leur tâche (F0.2, F0.5, F3.2).

NODE_ENV=development

# PostgreSQL + pgvector (F0.2) — un schéma et un rôle par service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=conexa
POSTGRES_PASSWORD=conexa_dev
POSTGRES_DB=conexa

# Redis (F0.2)
REDIS_URL=redis://localhost:6379

# RabbitMQ (F0.2)
RABBITMQ_URL=amqp://conexa:conexa_dev@localhost:5672

# Identity — paire RS256 de développement (générée localement, voir F1.1)
JWT_ISSUER=conexa-identity
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Ports locaux des services (v1)
GATEWAY_PORT=3000
IDENTITY_PORT=3001
FOOTBALL_PORT=3002
DATING_PORT=3003
TALENTS_PORT=3004
MARKETPLACE_PORT=3005
UPLOADS_PORT=3006

# Appels service à service : Dating demande le numéro à Identity sur /internal/*.
IDENTITY_URL=http://localhost:3001
SERVICE_TOKEN=jeton-de-service-local-a-remplacer

# Uploads : dossier local de développement (hors dépôt), ignoré par git
UPLOADS_STORAGE_DIR=.var/uploads

# Campay — environnement demo uniquement (F3.2). Jamais de clés de production.
CAMPAY_BASE_URL=
CAMPAY_APP_TOKEN=
CAMPAY_APP_SECRET=
