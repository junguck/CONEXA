# Copier en .env pour le développement local : cp .env.example .env
# Aucune valeur réelle, aucun secret de production dans ce fichier.
# Les variables des services sont ajoutées par leur tâche (F0.2, F0.5, F3.2).

NODE_ENV=development

# PostgreSQL + pgvector (F0.2) — un schéma et un rôle par service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=conexa
POSTGRES_PASSWORD=conexa_dev
POSTGRES_DB=conexa

# Un rôle de connexion par service (voir deploy/postgres/init).
# Mot de passe de développement uniquement ; jamais une valeur réelle.
CONEXA_DEV_DB_PASSWORD=conexa_dev
# Adapter les URLs ci-dessous si CONEXA_DEV_DB_PASSWORD change.
DATABASE_URL_IDENTITY=postgres://conexa_identity:conexa_dev@localhost:5432/conexa
DATABASE_URL_FOOTBALL=postgres://conexa_football:conexa_dev@localhost:5432/conexa
DATABASE_URL_DATING=postgres://conexa_dating:conexa_dev@localhost:5432/conexa
DATABASE_URL_TALENTS=postgres://conexa_talents:conexa_dev@localhost:5432/conexa
DATABASE_URL_MARKETPLACE=postgres://conexa_marketplace:conexa_dev@localhost:5432/conexa
DATABASE_URL_PARTNERS=postgres://conexa_partners:conexa_dev@localhost:5432/conexa
DATABASE_URL_PAYMENTS=postgres://conexa_payments:conexa_dev@localhost:5432/conexa
DATABASE_URL_BILLING=postgres://conexa_billing:conexa_dev@localhost:5432/conexa
DATABASE_URL_MESSAGING=postgres://conexa_messaging:conexa_dev@localhost:5432/conexa

# Redis (F0.2)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# RabbitMQ (F0.2)
RABBITMQ_USER=conexa
RABBITMQ_PASSWORD=conexa_dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://conexa:conexa_dev@localhost:5672

# Identity — paire RS256 de développement (générée localement, voir F1.1)
JWT_ISSUER=conexa-identity
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Ports locaux des services (v1)
GATEWAY_PORT=3000
IDENTITY_PORT=3001
FOOTBALL_PORT=3002
DATING_PORT=3003
TALENTS_PORT=3004
MARKETPLACE_PORT=3005
UPLOADS_PORT=3006

# Appels service à service : Dating demande le numéro à Identity sur /internal/*.
IDENTITY_URL=http://localhost:3001
SERVICE_TOKEN=jeton-de-service-local-a-remplacer

# Uploads : dossier local de développement (hors dépôt), ignoré par git
UPLOADS_STORAGE_DIR=.var/uploads

# MinIO compatible S3 (F0.2)
MINIO_ROOT_USER=conexa
MINIO_ROOT_PASSWORD=conexa_dev
MINIO_BUCKET=conexa
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000

# OpenTelemetry (F0.2)
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=conexa-dev

# Campay — environnement demo uniquement (F3.2). Jamais de clés de production.
CAMPAY_BASE_URL=
CAMPAY_APP_TOKEN=
CAMPAY_APP_SECRET=
