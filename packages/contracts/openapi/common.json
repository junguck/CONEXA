{
  "openapi": "3.1.0",
  "info": {
    "title": "Convexa — composants communs",
    "version": "1.0.0",
    "description": "Composants partagés (enveloppe d’erreur, pagination, primitives) générés depuis @conexa/contracts. Ne pas éditer à la main."
  },
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "ACCOUNT_PENDING",
                  "ACCOUNT_SUSPENDED",
                  "NOT_FOUND",
                  "VALIDATION_ERROR",
                  "INVALID_STATE",
                  "RATE_LIMITED",
                  "MATRICULE_TAKEN",
                  "OTP_INVALID",
                  "AGE_RESTRICTED",
                  "RELIABILITY_TOO_LOW",
                  "TEAM_ALREADY_MEMBER",
                  "TEAM_JOIN_COOLDOWN",
                  "TEAM_NOT_ACTIVE",
                  "NOT_CAPTAIN",
                  "FIELD_SLOT_TAKEN",
                  "REPORT_ALREADY_SUBMITTED",
                  "CHAT_DIGIT_BLOCKED",
                  "CHAT_CONTACT_BLOCKED",
                  "WEEKLY_QUOTA_EXCEEDED",
                  "PICK_EXPIRED",
                  "SLOT_FULL",
                  "FORMULA_CAP_EXCEEDED",
                  "PAYMENT_REQUIRED",
                  "CANCEL_WINDOW_CLOSED",
                  "CONTACT_NOT_REVEALED",
                  "ALREADY_BLOCKED",
                  "DUPLICATE_REQUEST",
                  "ENTITLEMENT_REQUIRED",
                  "PLAN_LIMIT_REACHED",
                  "PLAN_NOT_FOUND",
                  "PLAN_AUDIENCE_MISMATCH",
                  "PROMO_INVALID",
                  "LISTING_NOT_ACTIVE",
                  "LISTING_PROHIBITED",
                  "SELF_ORDER_FORBIDDEN",
                  "SLOT_ALREADY_BOOKED",
                  "REVISIONS_EXHAUSTED",
                  "ORDER_NOT_COMPLETED",
                  "OFFER_NOT_AVAILABLE",
                  "OFFER_SOLD_OUT",
                  "OFFER_LIMIT_REACHED",
                  "VOUCHER_INVALID",
                  "VOUCHER_ALREADY_USED",
                  "VOUCHER_EXPIRED",
                  "PARTNER_NOT_ACTIVE",
                  "ASSET_NOT_APPROVED",
                  "UPLOAD_TOO_LARGE",
                  "UPLOAD_TYPE_NOT_ALLOWED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "request_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "CursorQuery": {
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["limit"],
        "additionalProperties": false
      },
      "Uuid": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "IsoDateTime": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
      },
      "DateOnly": {
        "type": "string",
        "format": "date",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
      },
      "AmountFcfa": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  }
}
