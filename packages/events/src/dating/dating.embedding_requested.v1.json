{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conexa.app/events/dating/dating.embedding_requested.v1.json",
  "title": "dating.embedding_requested v1",
  "description": "Demande de calcul des trois vecteurs de rencontre (ADR 0003). Le producteur dating n'envoie que des identifiants de questions et d'options stables, jamais un libellé ni du texte libre.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "version", "occurred_at", "producer", "payload"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "dating.embedding_requested" },
    "version": { "const": 1 },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "producer": { "const": "dating" },
    "traceparent": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_id", "profile_id", "questionnaire_version", "answers"],
      "properties": {
        "user_id": { "type": "string", "minLength": 1 },
        "profile_id": { "type": "string", "minLength": 1 },
        "questionnaire_version": { "type": "integer", "minimum": 1 },
        "answers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values", "personality", "lifestyle"],
          "properties": {
            "values": { "$ref": "#/$defs/block" },
            "personality": { "$ref": "#/$defs/block" },
            "lifestyle": { "$ref": "#/$defs/block" }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "block": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/slug" },
          { "type": "integer", "minimum": 1, "maximum": 5 },
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/slug" }
          }
        ]
      }
    }
  }
}
