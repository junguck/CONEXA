{
  "name": "@conexa/service-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Socle commun des services Convexa : config Zod, base Kysely, JWT, logs masqués, filtre d'erreurs, santé",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
